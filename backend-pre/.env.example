# ====== 运行环境 ======
# development | production。production 会强制安全校验(密钥/CORS/synchronize)。
NODE_ENV=development
PORT=8770

# ====== 数据库 ======
# 开发可用 better-sqlite3;连接测试/生产环境时使用 mysql。
DB_TYPE=mysql
DB_HOST=db
DB_PORT=3306
DB_USER=airacm
DB_ROOT_PASSWORD=改成强随机 root 密码
DB_PASSWORD=改成强随机密码
DB_DATABASE=airacm
# DB_TYPE=better-sqlite3
# DB_DATABASE=airacm.sqlite
# DB_SSL=false
# 仅开发/首次 bootstrap 用:从实体建表。生产禁用(用 migration)。
# DB_SYNC=true
# pg 连接池上限(高并发可调大)。
DB_POOL_MAX=20

# ====== 鉴权 ======
# 生产必须 ≥32 字符随机串(如 openssl rand -hex 32),且非默认值,否则拒绝启动。
JWT_SECRET=dev-secret-change-in-prod
JWT_EXPIRES_IN=7d
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ====== CORS ======
# 生产必须设白名单(逗号分隔域名),禁止 *。开发留空即放开。
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ====== 多租户 ======
DEFAULT_TENANT_ID=t1

# ====== App 安装包上传 ======
# 默认写入仓库 frontend/public/downloads/app/airacm-android.apk。
# 前后端分容器部署时,这里应配置为共享卷中的绝对路径。
# APP_APK_PATH=/data/airacm/downloads/app/airacm-android.apk

# ====== 引导管理员(seed 用,生产务必改)======
ADMIN_PHONE=13900000000
ADMIN_PASSWORD=Admin@12345
BIZ_ADMIN_PHONE=13772066855
BIZ_ADMIN_PASSWORD=BizAdmin@12345
# seed 是否注入示例课程/激活码:生产 bootstrap 设 false(只建表+管理员)。
SEED_DEMO=true

# ====== 短信验证码(阿里云 Dysmsapi)======
# dev 模式:不真发短信,验证码固定为 SMS_DEV_CODE,联调用。
# 生产:SMS_DEV_MODE=false,并填齐下方 ALI_SMS_* 四项,否则启动即拒绝。
SMS_DEV_MODE=true
SMS_DEV_CODE=1234
# 阿里云 AccessKey(建议用 RAM 子账号,仅授权 AliyunDysmsFullAccess)
ALI_SMS_AK_ID=
ALI_SMS_AK_SECRET=
# 控制台申请的签名与验证码模板(模板内容须含 ${code})
ALI_SMS_SIGN=
ALI_SMS_TEMPLATE=
# 一般无需改
ALI_SMS_ENDPOINT=dysmsapi.aliyuncs.com
# 验证码有效期(秒)与同号重发最小间隔(秒,防短信轰炸)
SMS_CODE_TTL_SEC=300
SMS_RESEND_SEC=60

# ====== 微信支付(资质未到,默认关)======
# 开启时生产必须设真实 WECHAT_API_KEY(≥16 字符),否则拒绝启动。
WECHAT_PAY_ENABLED=false
WECHAT_MCH_ID=
WECHAT_API_KEY=dev-mch-key

# ====== 微信小程序 ======
# AppSecret 只放后端环境变量，禁止写入前端或提交仓库。
WECHAT_MINI_ENABLED=false
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_MINI_CONTENT_SECURITY_ENABLED=false
WECHAT_MINI_TIMEOUT_MS=5000
