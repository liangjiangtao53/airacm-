# ====== 运行环境 ======
# development | production。production 会强制安全校验(密钥/CORS/synchronize)。
NODE_ENV=development
PORT=8770

# ====== 数据库 ======
# 开发:better-sqlite3;生产:postgres。
DB_TYPE=better-sqlite3
DB_DATABASE=airacm.sqlite
# Postgres(生产)。也可用 DATABASE_URL 覆盖。
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=airacm
# DB_PASSWORD=请改成强密码
# DB_DATABASE=airacm
# DB_SSL=false
# DATABASE_URL=postgres://airacm:password@localhost:5432/airacm
# 仅开发/首次 bootstrap 用:从实体建表。生产禁用(用 migration)。
# DB_SYNC=true

# ====== 鉴权 ======
# 生产必须 ≥32 字符随机串(如 openssl rand -hex 32),且非默认值,否则拒绝启动。
JWT_SECRET=dev-secret-change-in-prod
JWT_EXPIRES_IN=7d

# ====== CORS ======
# 生产必须设白名单(逗号分隔域名),禁止 *。开发留空即放开。
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# ====== 多租户 ======
DEFAULT_TENANT_ID=t1

# ====== 引导管理员(seed 用,生产务必改)======
ADMIN_PHONE=13900000000
ADMIN_PASSWORD=admin-change-me

# ====== 短信验证码 ======
# 第一版无服务商:dev 万能码。生产接服务商前关闭 dev 模式即拒绝注册。
SMS_DEV_MODE=true
SMS_DEV_CODE=0000

# ====== 微信支付(资质未到,默认关)======
# 开启时生产必须设真实 WECHAT_API_KEY(≥16 字符),否则拒绝启动。
WECHAT_PAY_ENABLED=false
WECHAT_MCH_ID=
WECHAT_API_KEY=dev-mch-key
