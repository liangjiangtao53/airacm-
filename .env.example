# 维修翼站 — 整套部署环境变量(根级)
# cp .env.example .env 后填写真实值。docker compose 自动读取本目录 .env。

# ---- 数据库(MySQL) ----
COMPOSE_PROJECT_NAME=airacm
DB_TYPE=mysql
DB_HOST=db
DB_PORT=3306
DB_USER=airacm
DB_ROOT_PASSWORD=改成强随机 root 密码
DB_PASSWORD=改成强随机密码
DB_DATABASE=airacm

# ---- schema 同步 ----
# 保持 false。建表由首次 `node dist/seed.js` 完成(seed 内部 synchronize)。
# 仅当后续改了实体、想让 TypeORM 自动同步时才临时设 true(有丢列风险)。
DB_SYNC=false
DB_MIGRATIONS_RUN=true
DB_POOL_MAX=20
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120


JWT_SECRET=改成强随机密钥
JWT_EXPIRES_IN=12h

# ---- CORS ----
# 同域反代(/api)可留空;若前端独立域名,填 https://你的前端域名
CORS_ORIGINS=

# ---- App 安装包上传/下载共享目录 ----
# docker compose 会把此目录挂给 api、frontend、nginx。
# 后台上传会覆盖其中的 airacm-android.apk,用户从 /downloads/app/airacm-android.apk 下载。
APP_UPLOAD_DIR=./uploads/app

# ---- 题库图片共享目录 ----
# WPS/Excel 题目图片导入后保存到这里,前端通过 /api/question-images/xxx 访问。
QUESTION_IMAGE_DIR=./uploads/question-images

# ---- 短信(阿里云 Dysmsapi);生产必须关 dev 模式 ----
SMS_DEV_MODE=false
ALI_SMS_AK_ID=
ALI_SMS_AK_SECRET=
ALI_SMS_SIGN=
ALI_SMS_TEMPLATE=

# ---- 引导管理员(首次 seed 写入) ----
ADMIN_PHONE=13259858973
ADMIN_PASSWORD=改成强密码
BIZ_ADMIN_PHONE=13772066855
BIZ_ADMIN_PASSWORD=改成强密码

# =====================================================================
# 生成 JWT_SECRET:   openssl rand -base64 48
#
# 正式 TLS 证书(Let's Encrypt,需已解析的域名):
#   certbot certonly --webroot -w deploy/certbot -d your-domain.com
#   然后软链/拷贝到 deploy/nginx/certs/fullchain.pem 与 privkey.pem
#
# 无域名先本地自签测试(浏览器会告警,仅验证链路):
#   mkdir -p deploy/nginx/certs
#   openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
#     -keyout deploy/nginx/certs/privkey.pem \
#     -out deploy/nginx/certs/fullchain.pem \
#     -subj "/CN=localhost"
# =====================================================================
